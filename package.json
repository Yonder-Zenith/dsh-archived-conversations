{
  "name": "@local/dsh-archived-conversations",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Web panel listing every archived Harness conversation with log sizes, restore, open, and move-to-trash actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yonder-Zenith/dsh-archived-conversations.git"
  },
  "homepage": "https://github.com/Yonder-Zenith/dsh-archived-conversations#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
